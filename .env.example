# Coordinator API secret (never commit .env)
EDGE_API_KEY=replace_with_a_long_random_secret

# Android inference nodes: configure one or two Android phones initially.
# Windows/Linux can be additional inference nodes when they expose an authenticated OpenAI-compatible server.
NODE_1_PLATFORM=android
NODE_1_URL=http://192.168.1.101:8080
NODE_1_KEY=replace_with_android_node_key

NODE_2_PLATFORM=android
NODE_2_URL=http://192.168.1.102:8080
NODE_2_KEY=replace_with_second_android_node_key

# Optional Windows laptop model server (only configure after one is running).
# If coordinator runs in Docker Desktop, host.docker.internal resolves to the host.
# NODE_3_PLATFORM=windows
# NODE_3_URL=http://host.docker.internal:8081
# NODE_3_KEY=replace_with_pc_node_key

# Future MacBook integration is postponed: configure only after it is tested.
# NODE_4_PLATFORM=macos
# NODE_4_URL=http://192.168.1.105:8080
# NODE_4_KEY=replace_with_mac_node_key

NODE_TIMEOUT_SEC=120
